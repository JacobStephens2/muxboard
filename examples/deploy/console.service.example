# systemd unit for a muxboard process reverse-proxied under an existing site.
# Install: copy to /etc/systemd/system/muxboard.service && systemctl enable --now muxboard
#
# Critical: PrivateTmp=false when local=True. With PrivateTmp=true the service
# cannot see tmux sockets created by login shells under the real /tmp, so the
# dashboard shows no sessions even though `tmux ls` in a shell lists them.

[Unit]
Description=muxboard (under /console on the ops host)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/muxboard
PrivateTmp=false

# Prefer SOPS/secret-env or EnvironmentFile= for SESSION_SECRET - do not bake secrets here.
Environment=MUXBOARD_ORIGIN=https://ops.example.com
Environment=MUXBOARD_URL_PREFIX=/console
Environment=MUXBOARD_TMUX_USER=ubuntu
Environment=MUXBOARD_SESSION_COOKIE=dash_session
Environment=MUXBOARD_SESSION_SALT=dashboard-session
Environment=PYTHONUNBUFFERED=1
# EnvironmentFile=-/etc/muxboard/console.env

# Single gevent worker: flask-sock needs one process that can hold WebSockets open.
# gevent>=24.10.1 is required by modern gunicorn - `pip install muxboard[deploy]`.
ExecStart=/opt/muxboard/.venv/bin/gunicorn \
  -k gevent -w 1 -b 127.0.0.1:3492 --timeout 0 \
  behind_existing_login:app

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
